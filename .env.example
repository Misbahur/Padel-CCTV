# ==========================================================
# Konfigurasi Environment - Papan Skor Padel & CCTV
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# ==========================================================

# ── Server & Jaringan ────────────────────────────────────
PORT=8080
# IP LAN server untuk QR Code share ke HP (kosongkan = deteksi otomatis)
SERVER_IP=
# Opsional: URL lengkap server jika memakai domain / reverse proxy
# BASE_URL=http://192.168.1.20:8080

# ── Keamanan & Autentikasi ───────────────────────────────
# Isi ADMIN_PASSWORD saat setup awal. Jika diubah lewat Dashboard Admin,
# sistem otomatis menyimpan versi hash SHA-256 ke ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# PIN 4-digit per lapangan (bisa diubah dari Dashboard Admin)
COURT_1_PIN=1111
COURT_2_PIN=2222
COURT_3_PIN=3333

# ── Kamera CCTV (RTSP URL) ───────────────────────────────
# Kredensial stream RTSP disimpan di .env agar terpisah dari config.json
COURT_1_CAM_1_NAME=Kamera Utama
COURT_1_CAM_1_RTSP=rtsp://admin:PASSWORD@192.168.1.64:554/Streaming/Channels/101
COURT_2_CAM_1_NAME=Kamera Utama
COURT_2_CAM_1_RTSP=rtsp://admin:PASSWORD@192.168.1.65:554/Streaming/Channels/101
COURT_3_CAM_1_NAME=Kamera Utama
COURT_3_CAM_1_RTSP=rtsp://admin:PASSWORD@192.168.1.66:554/Streaming/Channels/101

# ── Penyimpanan & Binary (Opsional) ──────────────────────
# STORAGE_RETENTION_DAYS=7
# STORAGE_MIN_FREE_GB=15
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
